MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/habit_tracker
MONGODB_DB=habit_tracker
DEFAULT_USER_KEY=default-user
PORT=3001

# Frontend dev proxy target. Leave this as-is unless the API server port changes.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_USER_ID=default-user

# JWT authentication
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-secret-here
JWT_EXPIRES_IN=7d
